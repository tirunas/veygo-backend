generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String              @id @default(uuid())
  email              String              @unique
  passwordHash       String
  role               Role                @default(USER)
  loginAttempts      Int                 @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  auditLogs          AuditLog[]
  purchases          Purchase[]
  readyPlanPurchases ReadyPlanPurchase[]
  refreshTokens      RefreshToken[]
  userPlans          UserPlan[]

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
}

model UserPlan {
  id            String     @id @default(uuid())
  userId        String
  destinationId String
  status        PlanStatus @default(DRAFT)
  customData    Json       @default("{}")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases     Purchase[]
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([destinationId])
}

model Purchase {
  id          String          @id @default(uuid())
  userId      String
  userPlanId  String
  provider    PaymentProvider
  providerRef String
  amount      Int
  currency    String          @default("EUR")
  status      PaymentStatus   @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime        @default(now())
  user        User            @relation(fields: [userId], references: [id])
  userPlan    UserPlan        @relation(fields: [userPlanId], references: [id])

  @@index([userId])
  @@index([providerRef])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  event     String
  ip        String
  userAgent String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

model Destination {
  id                     String                  @id
  name                   String
  country                String
  tagline                String                  @default("")
  bestSeason             String?
  imgUrl                 String                  @default("")
  heroImageUrl           String                  @default("")
  imgFileId              String?    @db.Uuid
  heroImageFileId        String?    @db.Uuid
  currentWeather         String                  @default("")
  description            String                  @default("")
  highlights             Json                    @default("[]")
  flightHours            Int?
  minDailyBudget         Int?
  startingPrice          Int?
  soldCount              Int                     @default(0)
  weatherData            Json                    @default("[]")
  whyData                Json                    @default("[]")
  compareData            Json                    @default("{}")
  tipsHtml               String?
  emergencyData          Json                    @default("{}")
  tagsData               Json                    @default("[]")
  photos                 Json                    @default("[]")
  lat                    Float?
  lng                    Float?
  radiusKm               Float                   @default(25)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  destinationAttractions DestinationAttraction[]
  destinationHotels      DestinationHotel[]
  destinationRestaurants DestinationRestaurant[]
  itinerarySegments      ItinerarySegment[]
  pipelineJobs           PipelineJob[]
  styles                 DestinationStyle[]

  @@index([name])
}

model Attraction {
  id                 String                  @id
  name               String
  lat                Float
  lng                Float
  category           AttractionCategory
  description        String
  img                String
  imgFileId          String?    @db.Uuid
  hook               String?
  tip                String?
  nearbyFoodRadiusKm Float                   @default(1.0)
  priceAndDuration   String?
  openingHours       String?
  bestTime           String?
  source             String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  destinations       DestinationAttraction[]

  @@index([lat, lng])
}

model Restaurant {
  id           String                  @id
  name         String
  lat          Float
  lng          Float
  type         String
  cuisine      String?
  price        String
  description  String?
  signature    String?
  reviews      Json                    @default("[]")
  openingHours String?
  delivery     Boolean                 @default(false)
  petFriendly  Boolean                 @default(false)
  img          String?
  imgFileId    String?    @db.Uuid
  source       String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  destinations DestinationRestaurant[]

  @@index([lat, lng])
}

model Hotel {
  id            String             @id
  name          String
  lat           Float
  lng           Float
  tier          HotelTier
  area          String
  pricePerNight Int
  rating        String
  img           String
  imgFileId     String?    @db.Uuid
  highlights    Json               @default("[]")
  amenities     Json               @default("[]")
  roomTypes     Json               @default("[]")
  walkTo        Json               @default("{}")
  source        String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  destinations  DestinationHotel[]

  @@index([lat, lng])
}

model DestinationAttraction {
  destinationId String
  attractionId  String
  attraction    Attraction  @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([destinationId, attractionId])
  @@index([destinationId])
  @@index([attractionId])
}

model DestinationRestaurant {
  destinationId String
  restaurantId  String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([destinationId, restaurantId])
  @@index([destinationId])
  @@index([restaurantId])
}

model DestinationHotel {
  destinationId String
  hotelId       String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([destinationId, hotelId])
  @@index([destinationId])
  @@index([hotelId])
}

model Itinerary {
  id        String             @id @default(cuid())
  title     String?
  days      Json               @default("[]")
  costs     Json               @default("{}")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  segments  ItinerarySegment[]
  readyPlan ReadyPlan?
}

model ItinerarySegment {
  id            String      @id @default(cuid())
  itineraryId   String
  destinationId String
  order         Int
  days          Json        @default("[]")
  costs         Json        @default("{}")
  destination   Destination @relation(fields: [destinationId], references: [id])
  itinerary     Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)

  @@index([itineraryId])
  @@index([destinationId])
}

model ReadyPlan {
  id          String              @id
  itineraryId String              @unique
  title       String
  subtitle    String
  price       Int
  imgUrl      String
  badge       String?
  tags        String[]
  isPublished Boolean             @default(false)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  itinerary   Itinerary           @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  purchases   ReadyPlanPurchase[]
}

model ReadyPlanPurchase {
  id          String    @id @default(cuid())
  userId      String
  readyPlanId String
  amount      Int
  purchasedAt DateTime  @default(now())
  readyPlan   ReadyPlan @relation(fields: [readyPlanId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([readyPlanId])
}

model Experience {
  id            String   @id
  destinationId String?
  title         String
  subtitle      String
  category      String
  heroImgUrl    String
  price         String
  duration      String
  tags          String[]
  content       Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Testimonial {
  id              String  @id
  text            String
  author          String
  city            String
  initials        String
  colorHex        String
  destinationName String?
  tripDate        String?
  highlight       String?
  savedAmount     String?
}

model PipelineJob {
  id            String         @id @default(cuid())
  destinationId String
  type          String
  status        String         @default("pending")
  errorMessage  String?
  itemCount     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         PipelineItem[]
  destination   Destination    @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([destinationId])
  @@index([status])
  @@index([destinationId, type])
}

model PipelineItem {
  id              String      @id @default(cuid())
  jobId           String
  status          String      @default("pending")
  googlePlaceId   String?
  name            String
  address         String?
  lat             Float?
  lng             Float?
  rating          Float?
  openingHours    String?
  photos          String[]
  nameLt          String?
  descriptionLt   String?
  wowFacts        String[]
  hook            String?
  youtubeLinks    String[]
  instagramLinks  String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  bestTimeToVisit String?
  bookingUrls     String[]
  category        String?
  officialWebsite String?
  ticketInfo      String?
  travellerTips   String[]
  howToGetThere   String?
  bestPhotoSpot   String?
  insiderTip      String?
  hiddenNearby    String?
  avoidIfYou      String?
  uniquenessScore Int?
  job             PipelineJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([status])
}

model Style {
  id           String             @id @default(uuid())
  slug         String             @unique
  labelLt      String
  icon         String?
  sortOrder    Int                @default(0)
  destinations DestinationStyle[]
}

model DestinationStyle {
  destinationId String
  styleId       String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  style         Style       @relation(fields: [styleId], references: [id], onDelete: Cascade)

  @@id([destinationId, styleId])
}

enum Role {
  USER
  ADMIN
}

enum PlanStatus {
  DRAFT
  PAID
  COMPLETE
}

enum PaymentProvider {
  MONTONIO
  STRIPE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AttractionCategory {
  popular
  gem
}

enum HotelTier {
  budget
  mid
  comfort
}

model Photo {
  id         String   @id @default(uuid())
  url        String
  filename   String
  entityType String
  entityId   String
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  alt        String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, sortOrder])
  @@index([entityType, entityId, isPrimary])
}
