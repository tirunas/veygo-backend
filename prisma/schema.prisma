generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PlanStatus {
  DRAFT
  PAID
  COMPLETE
}

enum PaymentProvider {
  MONTONIO
  STRIPE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AttractionCategory {
  popular
  gem
}

enum HotelTier {
  budget
  mid
  comfort
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  loginAttempts Int            @default(0)
  lockedUntil   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  userPlans     UserPlan[]
  purchases     Purchase[]
  auditLogs     AuditLog[]
  readyPlanPurchases ReadyPlanPurchase[]

  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  family    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([family])
}

model UserPlan {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationId String
  status        PlanStatus @default(DRAFT)
  customData    Json       @default("{}")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases     Purchase[]

  @@index([userId])
  @@index([destinationId])
}

model Purchase {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id])
  userPlanId  String
  userPlan    UserPlan        @relation(fields: [userPlanId], references: [id])
  provider    PaymentProvider
  providerRef String
  amount      Int
  currency    String          @default("EUR")
  status      PaymentStatus   @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@index([providerRef])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  event     String
  ip        String
  userAgent String
  meta      Json     @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

model Destination {
  id             String   @id
  name           String
  country        String
  styles         String[]
  bestSeason     String
  imgUrl         String
  heroImageUrl   String
  currentWeather String   @default("")
  content        Json
  lat            Float?
  lng            Float?
  radiusKm       Float    @default(25)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  destinationAttractions DestinationAttraction[]
  destinationRestaurants DestinationRestaurant[]
  destinationHotels      DestinationHotel[]
  itinerarySegments     ItinerarySegment[]

  @@index([name])
}

model Attraction {
  id               String             @id
  name             String
  lat              Float
  lng              Float
  category         AttractionCategory
  description      String
  img              String
  priceAndDuration String?
  openingHours     String?
  bestTime         String?
  source           String?
  content          Json               @default("{}")
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  destinations DestinationAttraction[]

  @@index([lat, lng])
}

model Restaurant {
  id           String   @id
  name         String
  lat          Float
  lng          Float
  type         String
  cuisine      String?
  price        String
  openingHours String?
  delivery     Boolean  @default(false)
  petFriendly  Boolean  @default(false)
  img          String?
  source       String?
  content      Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  destinations DestinationRestaurant[]

  @@index([lat, lng])
}

model Hotel {
  id            String    @id
  name          String
  lat           Float
  lng           Float
  tier          HotelTier
  area          String
  pricePerNight Int
  rating        String
  img           String
  source        String?
  content       Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  destinations DestinationHotel[]

  @@index([lat, lng])
}

model DestinationAttraction {
  destinationId String
  attractionId  String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  attraction    Attraction  @relation(fields: [attractionId], references: [id], onDelete: Cascade)

  @@id([destinationId, attractionId])
  @@index([destinationId])
  @@index([attractionId])
}

model DestinationRestaurant {
  destinationId String
  restaurantId  String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([destinationId, restaurantId])
  @@index([destinationId])
  @@index([restaurantId])
}

model DestinationHotel {
  destinationId String
  hotelId       String
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  hotel         Hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@id([destinationId, hotelId])
  @@index([destinationId])
  @@index([hotelId])
}

model Itinerary {
  id        String             @id @default(cuid())
  title     String?
  days      Json               @default("[]")
  costs     Json               @default("{}")
  segments  ItinerarySegment[]
  readyPlan ReadyPlan?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model ItinerarySegment {
  id            String      @id @default(cuid())
  itineraryId   String
  destinationId String
  order         Int
  days          Json        @default("[]")
  costs         Json        @default("{}")
  itinerary     Itinerary   @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  destination   Destination @relation(fields: [destinationId], references: [id])

  @@index([itineraryId])
  @@index([destinationId])
}

model ReadyPlan {
  id          String              @id
  itineraryId String              @unique
  title       String
  subtitle    String
  price       Int
  imgUrl      String
  badge       String?
  tags        String[]
  isPublished Boolean             @default(false)
  itinerary   Itinerary           @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  purchases   ReadyPlanPurchase[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model ReadyPlanPurchase {
  id          String   @id @default(cuid())
  userId      String
  readyPlanId String
  amount      Int
  purchasedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  readyPlan   ReadyPlan @relation(fields: [readyPlanId], references: [id])

  @@index([userId])
  @@index([readyPlanId])
}

model Experience {
  id            String   @id
  destinationId String?
  title         String
  subtitle      String
  category      String
  heroImgUrl    String
  price         String
  duration      String
  tags          String[]
  content       Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Testimonial {
  id              String  @id
  text            String
  author          String
  city            String
  initials        String
  colorHex        String
  destinationName String?
  tripDate        String?
  highlight       String?
  savedAmount     String?
}
